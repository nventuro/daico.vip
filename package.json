{
  "name": "daico.vip",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "preview": "vite preview",
    "db:link": "set -a && . ./.env && supabase link --project-ref $SUPABASE_PROJECT_REF",
    "db:push": "set -a && . ./.env && supabase db push && node scripts/verify-db-security.mjs",
    "db:verify": "set -a && . ./.env && node scripts/verify-db-security.mjs",
    "db:migration:new": "supabase migration new",
    "guides:import": "set -a && . ./.env && node scripts/import-guides.mjs",
    "worker:test": "npm --prefix worker test && npm --prefix worker run check",
    "worker:deploy": "set -a && . ./.env && cd worker && npx wrangler deploy",
    "worker:secret": "set -a && . ./.env && cd worker && printf '%s' \"$ANTHROPIC_API_KEY\" | npx wrangler secret put ANTHROPIC_API_KEY",
    "worker:cert": "set -a && . ./.env && cd worker && npx wrangler cert upload certificate-authority --ca-cert ../supabase/ca.crt --name supabase-root",
    "worker:hyperdrive": "set -a && . ./.env && node scripts/trip-inbox-writer-password.mjs",
    "worker:tail": "set -a && . ./.env && cd worker && npx wrangler tail"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.95.3",
    "@tabler/icons-react": "^3.36.1",
    "@tailwindcss/vite": "^4.1.18",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-heading": "^3.31.0",
    "@tiptap/extension-list": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/markdown": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "fractional-indexing": "^4.0.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-image-crop": "^11.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sqlocal": "^0.18.0",
    "tailwindcss": "^4.1.18",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "supabase": "^2.76.8",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  }
}
