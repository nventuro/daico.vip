# Copied to `.env` (gitignored) and filled in; the README's first-time setup
# says where each comes from. Every script reads only the ones it needs.
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
# The email worker's (`worker:*`): a token that may edit Workers, Hyperdrive
# and certificates.
CLOUDFLARE_INBOX_API_TOKEN=
ANTHROPIC_API_KEY=
# The files worker's (`files:*`): a token that may edit Workers and R2, and
# nothing on the zone.
CLOUDFLARE_FILES_API_TOKEN=
# The backup's, from this machine (`backup:check`, `backup:restore`): the
# backup bucket in B2 with a key that may read it, and the attachments bucket
# in R2 with a token that may write it — the restore's. The nightly job holds
# its own, narrower pair as GitHub secrets.
B2_ENDPOINT=
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
